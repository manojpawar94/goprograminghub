{"pageProps":{"post":{"title":"Variables and Data Types","excerpt":"Learn about Python variables and the different data types available.","createdAt":"2024-01-17","author":{"name":"GoProgrammingHub","permalink":"/authors/manoj-pawar","profilePictureUrl":"/images/manoj-pawar.jpg","slug":"manoj-pawar"},"body":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta content=\"width=device-width, initial-scale=1\" name=\"viewport\">\n  </head>\n  <body>\n    <h1>Variables and Data Types</h1>\n    <h2>Variables</h2>\n    <div class=\"remark-highlight\">\n      <pre class=\"language-python\"><code class=\"language-python\">x<span class=\"token space\"> </span><span class=\"token operator\">=</span><span class=\"token space\"> </span><span class=\"token number\">5</span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token comment\">#<span class=\"token space\"> </span>Integer</span><span class=\"token lf\"></span>\n<span class=\"token lf\"></span>y<span class=\"token space\"> </span><span class=\"token operator\">=</span><span class=\"token space\"> </span><span class=\"token string\">\"Hello\"</span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token comment\">#<span class=\"token space\"> </span>String</span><span class=\"token lf\"></span>\n<span class=\"token lf\"></span>z<span class=\"token space\"> </span><span class=\"token operator\">=</span><span class=\"token space\"> </span><span class=\"token number\">3.14</span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token comment\">#<span class=\"token space\"> </span>Float</span><span class=\"token lf\"></span>\n<span class=\"token lf\"></span>is_true<span class=\"token space\"> </span><span class=\"token operator\">=</span><span class=\"token space\"> </span><span class=\"token boolean\">True</span><span class=\"token space\"> </span><span class=\"token comment\">#<span class=\"token space\"> </span>Boolean</span>\n</code></pre>\n    </div>\n    <h2>Basic Data Types</h2>\n    <ol>\n      <li>\n        <p><strong>Numbers</strong></p>\n        <ul>\n          <li>Integers: <code class=\"language-unknown\">5</code>, <code class=\"language-unknown\">-3</code>, <code class=\"language-unknown\">0</code></li>\n          <li>Floats: <code class=\"language-unknown\">3.14</code>, <code class=\"language-unknown\">-0.001</code></li>\n        </ul>\n      </li>\n      <li>\n        <p><strong>Strings</strong></p>\n        <div class=\"remark-highlight\">\n          <pre class=\"language-python\"><code class=\"language-python\">name<span class=\"token space\"> </span><span class=\"token operator\">=</span><span class=\"token space\"> </span><span class=\"token string\">\"Alice\"</span><span class=\"token lf\"></span>\n<span class=\"token lf\"></span>greeting<span class=\"token space\"> </span><span class=\"token operator\">=</span><span class=\"token space\"> </span><span class=\"token string\">'Hello<span class=\"token space\"> </span>World'</span>\n</code></pre>\n        </div>\n      </li>\n      <li>\n        <p><strong>Booleans</strong></p>\n        <div class=\"remark-highlight\">\n          <pre class=\"language-python\"><code class=\"language-python\">is_active<span class=\"token space\"> </span><span class=\"token operator\">=</span><span class=\"token space\"> </span><span class=\"token boolean\">True</span><span class=\"token lf\"></span>\n<span class=\"token lf\"></span>is_admin<span class=\"token space\"> </span><span class=\"token operator\">=</span><span class=\"token space\"> </span><span class=\"token boolean\">False</span>\n</code></pre>\n        </div>\n      </li>\n    </ol>\n    <h2>Type Checking</h2>\n    <div class=\"remark-highlight\">\n      <pre class=\"language-python\"><code class=\"language-python\"><span class=\"token builtin\">type</span><span class=\"token punctuation\">(</span><span class=\"token number\">5</span><span class=\"token punctuation\">)</span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token comment\">#<span class=\"token space\"> </span>&#x3C;class<span class=\"token space\"> </span>'int'></span><span class=\"token lf\"></span>\n<span class=\"token lf\"></span><span class=\"token builtin\">type</span><span class=\"token punctuation\">(</span><span class=\"token string\">\"Hello\"</span><span class=\"token punctuation\">)</span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token comment\">#<span class=\"token space\"> </span>&#x3C;class<span class=\"token space\"> </span>'str'></span><span class=\"token lf\"></span>\n<span class=\"token lf\"></span><span class=\"token builtin\">type</span><span class=\"token punctuation\">(</span><span class=\"token boolean\">True</span><span class=\"token punctuation\">)</span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token comment\">#<span class=\"token space\"> </span>&#x3C;class<span class=\"token space\"> </span>'bool'></span>\n</code></pre>\n    </div>\n    <h2>Type Conversion</h2>\n    <div class=\"remark-highlight\">\n      <pre class=\"language-python\"><code class=\"language-python\"><span class=\"token builtin\">int</span><span class=\"token punctuation\">(</span><span class=\"token string\">\"5\"</span><span class=\"token punctuation\">)</span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token comment\">#<span class=\"token space\"> </span>5</span><span class=\"token lf\"></span>\n<span class=\"token lf\"></span><span class=\"token builtin\">str</span><span class=\"token punctuation\">(</span><span class=\"token number\">42</span><span class=\"token punctuation\">)</span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token space\"> </span><span class=\"token comment\">#<span class=\"token space\"> </span>\"42\"</span><span class=\"token lf\"></span>\n<span class=\"token lf\"></span><span class=\"token builtin\">float</span><span class=\"token punctuation\">(</span><span class=\"token string\">\"3.14\"</span><span class=\"token punctuation\">)</span><span class=\"token space\"> </span><span class=\"token comment\">#<span class=\"token space\"> </span>3.14</span>\n</code></pre>\n    </div>\n  </body>\n</html>\n","slug":"04_variables_data_types"},"posts":[{"title":"Introduction to Python","excerpt":"Learn the basics of Python programming language and its applications.","createdAt":"2024-01-17","author":"manoj-pawar","permalink":"/posts/programming/python/01_introduction","index":0,"slug":"01_introduction"},{"title":"Setting Up Python Environment","excerpt":"Step-by-step guide to install Python and set up your development environment.","createdAt":"2